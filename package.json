{
  "name": "vetro-pdf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "npm run build && playwright test",
    "docs:screenshots": "npm run build && playwright test -c playwright.docs.config.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "lucide-react": "^1.69.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "description": "Local-first PDF annotation PWA: type, draw and paste images on any PDF, save over the original, and keep every annotation editable.",
  "author": "Alen Henjas",
  "license": "MIT",
  "homepage": "https://alenhenjas.github.io/vetro-pdf/",
  "repository": {
    "type": "git",
    "url": "https://github.com/alenhenjas/vetro-pdf.git"
  },
  "keywords": [
    "pdf",
    "pdf-annotation",
    "pwa",
    "react",
    "typescript",
    "file-system-access-api",
    "pdfjs",
    "pdf-lib"
  ]
}
